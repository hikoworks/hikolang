import std.primitive
import std.string_representation
import std.primitive
import std.allocator
module std.string_low

@public
struct string[encoding : string_representation] {
    @tagged $allocator <- &std.default_allocator
    _ptr <- __ptr_0
    _capacity <- __is_0
    _size <- __is_0

    @type
    fn _sso_capacity() -> __is {
        return __sizeof(self) &- __sizeof(__ptr) &- __is_1
    }

    fn _last_byte() {
        return &make_ref(self, __i8, __sizeof(self) &- __is_1)
    }

    fn _set_size(size : __is) {
        if (size <= _sso_capacity()) {
            __set_tag($allocator, __i1_0)
            _last_byte() = _sso_capacity() &- size
        } else {
            __set_tag($allocator, __i1_1)
            _size = size
        }
    }

    @public
    fn __init__() {
        $self.$allocator <- &$allocator
        _set_size(__is_0)
    }

    @public
    fn __init__(other : &const string) {
        $self.$allocator <- &$allocator

        new_size = other.size()
        _set_size(new_size)
        if (new_size <= _sso_capacity()) {
            // small string.
            __memcpy(make_ptr(_ptr), make_ptr(other._ptr), _sso_capacity())
        } else {
            (_ptr, _capacity) = $self.$allocator.allocate(new_size &+ __is_1)
            __memcpy(_ptr, other._ptr, new_size &+ __is_1)
        }
    }

    fn __deinit__() {
        if (_is_long()) {
            $allocator.dealloc(_ptr, _capacity)
        }
    }

    @public
    fn clear() {
        if (_is_long()) {
            $allocator.dealloc(_ptr, _capacity)
        }
        _ptr <- __ptr_0
        _capacity <- __is_0
        _size <- __is_0
        std.set_tag($allocator, 0)
        _short_size() = _sso_capacity()
    }

    fn _pointer_member() {
        return &make_ref(self, __ptr, 0)
    }

    fn _int_pointer_member() {
        return &make_ref(self, __is, 0)
    }

    fn _size_member() {
        return &make_ref(self, __is, 1)
    }

    fn _capacity_member() {
        return &make_ref(self, __is, 2)
    }

    fn _last_byte() {
        return &make_ref(self, __i8, __alloc_size())
    }

    fn _is_short_string() -> bool {
        if (std.target.endian == little) {
            return _capacity_member() < __is_0
        } else {
            return _capacity_member() & __is_1 == __is_1
        }
    }

    fn _is_long_string() -> bool {
        return not _is_short_string();
    }

    fn _capacity() -> __is {
        if (_is_short_string()) {
            return _sso_capacity()

        } else if (std.target.endian == little) {
            return _capacity_member() << __size_constant_1

        } else {
            return _capacity_member() - __size_constant_1
        }
    }

    fn _size() -> __is {
        if (not _is_short_string()) {
            return _size_member();

        } else if (std.target.endian == little) {
            if (std.target.register_bits == 64) {
                return _sso_capacity() - (_capacity_member() >> __is_56)
            } else {
                return _sso_capacity() - (_capacity_member() >> __is_24)
            }

        } else {
            return _sso_capacity() - ((_capacity_member() & __is_255) >> __is_1)
        }
    }

    /** The pointer to where the characters of the string are located.
     */
    fn _pointer() -> __ptr
    {
        if (_is_short_string()) {
            return __make_ptr(self, 0)
        } else {
            return __make_ref(self, __ptr, 0)
        }
    }

    
}

