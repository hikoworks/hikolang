
class raw_ptr[T : type] {
    value_type = T
    _p = 0 : __builtin_ptr

    fn __init__(self : &&raw_ptr[T]) = default

    fn __init__(self : &&raw_ptr[T], p : __builtin_ptr) {
        self._p = p
    }

    fn __index__(self := ptr_type[T], i : int) {
        return __builtin_dereference(type(self), self._p, i)
    }

    fn __dereference__(self := ptr_type[T])
    {
        return __builtin_dereference(type(self), self._p)        
    }

    fn raw() -> __builtin_ptr
    {
        return self._p
    }
}
